{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailbox",
  "version": "0.1.0",
  "identifier": "com.mailbox.desktop",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}

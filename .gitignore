# macOS
.DS_Store

# IDE
.idea/
*.iml

# Rust / Cargo 构建产物
src-tauri/target/

# Tauri 构建期生成的 ACL schema：随 feature 组合变化（如 --features e2e 会加入
# wdio-webdriver 权限），每次构建都产生噪音 diff，不属源码，不入库。
src-tauri/gen/schemas/

# 本地中间产物（.temp/ 含构建工具链、冒烟素材与 spike，不进公开仓库）
.temp/

# 内部文档与设计稿：docs-private/ 与 design/ 含企业内网细节与账号示例，
# 不随公开仓库分发（如需可放置于私有仓库）
docs-private/
design/

# 数据库与凭据文件（运行期产生）
*.db
*.sqlite
*.sqlite3
*.key
*.pem
*.pfx

# MSIX 打包产物（build-msix.ps1 输出，不入库）
store-assets/msix/out/

# 本地环境
*.local
.env

# E2E 自动化测试（依赖与运行产物：截图、日志、隔离 HOME）
e2e/node_modules/
e2e/artifacts/
e2e/outbox/
e2e/logs/
e2e/support/__pycache__/

# 工作区记忆与本地任务数据（WorkBuddy 管理，非源码）
.workbuddy/
